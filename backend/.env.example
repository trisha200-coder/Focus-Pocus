# Server port
PORT=3000

# Prototype User ID (used for single-user dev testing)
PROTOTYPE_USER_ID=demo-prototype-user

# (Optional) Supabase Credentials - leave blank for local development mode
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# (Optional) Gemini API Key for AI features - leave blank to use built-in companion
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
